           </item>
          </layout>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="verticalSpacer_7">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tabCompatibility2">
      <attribute name="title">
       <string>Compatibility 2</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_23">
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_8">
         <item>
          <layout class="QVBoxLayout" name="verticalLayout_30">
           <item>
            <widget class="QCheckBox" name="cbCompatUseOriginalMissileClippingHeight">
             <property name="toolTip">
              <string>&lt;p&gt;This allows for decorations to be pass-through for projectiles as they were originally in Doom.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Use original missile clipping height</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatUseSectorBasedSoundTargetCode">
             <property name="text">
              <string>Use sector based sound target code</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatTraceIgnoreLinesWithoutSameSectorOnBothSides">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Doom's hitscan tracing code ignores all lines with both sides in the same sector. ZDoom's does not. This option reverts to the original but less precise behavior. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Trace ignore lines w/ same sector on both sides</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatLimitDehMaxHealthToHealthBonus">
             <property name="text">
              <string>Limit deh.MaxHealth to health bonus</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatRavensScrollersUseOriginalSpeed">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The scrolling floor specials in Heretic and Hexen move the player much faster than the actual texture scrolling speed. Enable this option to restore this effect. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Raven's scrollers use original speed</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatAddNOGRAVITYFlagToSpheres">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Add NOGRAVITY to actors named InvulnerabilitySphere, Soulsphere, Megasphere and BlurSphere when spawned by the map.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Add NOGRAVITY flag to spheres</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbDontStopPlayerScriptsOnDisconnect">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;When a player leaves the game, don't stop any scripts of that player that are still running.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Don't stop player scripts on disconnect</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbOldZDoomHorizontalThrust">
             <property name="toolTip">
              <string>&lt;p&gt;If this is enabled, explosions cause a strong horizontal thrust like in old ZDoom versions.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Old ZDoom horizontal thrust</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbOldZDoomBridgeDrops">
             <property name="toolTip">
              <string>&lt;p&gt;If this is enabled, non-SOLID things like flags fall through bridges (as they used to do in old ZDoom versions).&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Old ZDoom bridge drops</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbOldZDoomJumpPhysics">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Uses old ZDoom jump physics, it's a minor bug in the gravity code that causes gravity application in the wrong place.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>ZDoom 1.23B33 jump physics</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatUseVanillaAutoaimTracerBehavior">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;p&gt;Q-Zandronum uses more tracers to fill in the gaps, this reverts it to vanilla's 3 tracer behavior&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Use vanilla autoaim tracer behavior</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatMaskedMidtex">
             <property name="text">
              <string>Ignore compositing when drawing masked midtextures</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatBadAngles">
             <property name="text">
              <string>It is impossible to face directly NSEW</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatDisableCrosshairAccurate">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Bring back vanilla ZDoom shooting below the crosshair.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Disable shooting where crosshair is</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QVBoxLayout" name="verticalLayout_29">
           <item>
            <widget class="QCheckBox" name="cbCompatFindShortestTexturesLikeDoom">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Use Doom's shortest texture find behavior. This is requied by some WADs in MAP07.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Find shortest textures like Doom</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatLimitPainElementals">
             <property name="text">
              <string>Limit pain elementals to 20 lost souls</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatSpawnItemDropsOnTheFloor">
             <property name="text">
              <string>Spawned item drops on the floor</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatNETScriptsAreClientside">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Treat ACS scripts with the SCRIPTF_Net flag to be client side, i.e. executed on the clients, but not on the server.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>NET scripts are clientside</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatNoPredictionACS">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Don't execute predicted ACS scripts on client side. Turning this on can fix ACS teleports or jumppads on maps that are not using ACS_ExecuteWithResult.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="text">
              <string>Don't execute prediction ACS on client</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatActorsAreInfinitelyTall">
             <property name="toolTip">
              <string>&lt;p&gt;This allows for decorations to be pass-through for projectiles as they were originally in Doom.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Actors are infinitely tall</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatUseBuggierStairBuilding">
             <property name="toolTip">
              <string>Don't fix loop index for stair building.</string>
             </property>
             <property name="text">
              <string>Use buggier stair building</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatDisableBoomDoorLightEffect">
             <property name="text">
              <string>Disable Boom door light effect</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatAllSpecialLinesCanDropUseLines">
             <property name="text">
              <string>All special lines can drop use lines</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatOriginalSoundCurve">
             <property name="text">
              <string>Original sound curve</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatFullWeaponLower">
             <property name="text">
              <string>Disallow weapon change until fully drawn or hidden</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatWestSpawnsAreSilent">
             <property name="text">
              <string>West spawns are silent</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatFloorMove">
             <property name="text">
              <string>Use the same floor motion behavior as Doom</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="cbCompatDisableWallFriction">
             <property name="text">
              <string>Disable wall friction</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="verticalSpacer_8">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
